# ============================================
# ServiPy - Variables de Entorno
# ============================================
# Copia este archivo como .env y completa los valores.
# El archivo .env NO se sube al repositorio.

# MySQL (Docker Compose)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=servipy
MYSQL_USER=
MYSQL_PASSWORD=

# JWT (mínimo 32 caracteres para HS256)
JWT_SECRET=
JWT_EXPIRATION_MINUTES=30

# CORS (URL del frontend en producción)
CORS_ALLOWED_ORIGIN=http://localhost

# Spring Profile (local | prod)
SPRING_PROFILES_ACTIVE=prod

# Docker Registry (opcional, e.g. tu-usuario-dockerhub/)
DOCKER_REGISTRY=
TAG=latest
