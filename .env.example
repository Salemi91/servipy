# ============================================
# ServiPy - Variables de Entorno
# ============================================
# Copia este archivo como .env y completa los valores.
# .env NO se sube al repositorio (ver .gitignore).
#
# Los valores de ejemplo sirven para DESARROLLO LOCAL.
# En producción, todos deben redefinirse con valores propios.

# --------------------------------------------
# Base de datos (MySQL)
# --------------------------------------------
MYSQL_DATABASE=
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
# Host visto por el backend: nombre del servicio de Docker Compose,
# o "localhost" si ejecutás el backend fuera de Docker.
MYSQL_HOST=mysql_db
MYSQL_PORT=3306

# --------------------------------------------
# Seguridad (JWT)
# --------------------------------------------
# Mínimo 32 caracteres (HS256). CAMBIAR OBLIGATORIAMENTE EN PRODUCCIÓN:
# generar con `openssl rand -base64 48` y no reutilizar entre entornos.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=30

# --------------------------------------------
# Aplicación
# --------------------------------------------
# local = desarrollo | prod = producción
SPRING_PROFILES_ACTIVE=local
# Único origen permitido por CORS. En producción, el dominio real con https.
CORS_ALLOWED_ORIGIN=http://localhost:4200
# Puerto HTTP del backend. Si lo cambiás, ajustá también frontend/nginx.conf
# y el mapeo de puertos de docker-compose.yml.
PORT=8080

# --------------------------------------------
# Docker (opcional)
# --------------------------------------------
DOCKER_REGISTRY=barieldev/
TAG=1.0.1
