# ============================================
# ServiPy - Variables de Entorno
# ============================================
# Copia este archivo como .env y completa los valores.
# El archivo .env NO se sube al repositorio.

# MySQL (Docker Compose)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=servipy
MYSQL_USER=
MYSQL_PASSWORD=

# Spring Boot
DB_URL=jdbc:mysql://localhost:3306/servipy
DB_USERNAME=
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRATION_MINUTES=30

# CORS
CORS_ALLOWED_ORIGIN=http://localhost:4200

# Spring Profile (local | prod)
SPRING_PROFILES_ACTIVE=local
